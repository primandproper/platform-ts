{
  "name": "@primandproper/platform-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isomorphic infrastructure abstractions for backend and frontend TypeScript.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "22.19.21",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.8.4",
    "tsup": "8.5.1",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "2.1.9"
  }
}
