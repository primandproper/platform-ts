{
  "name": "@primandproper/secrets",
  "version": "0.0.3",
  "type": "module",
  "description": "Server-only secrets: a SecretSource interface with swappable providers.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primandproper/platform-ts.git",
    "directory": "packages/secrets"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.699.0",
    "@google-cloud/secret-manager": "6.2.0",
    "@kubernetes/client-node": "1.4.0",
    "@primandproper/cache": "workspace:*",
    "@primandproper/errors": "workspace:*",
    "@primandproper/observability": "workspace:*",
    "zod": "3.25.76"
  }
}
