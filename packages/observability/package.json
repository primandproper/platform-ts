{
  "name": "@primandproper/observability",
  "version": "0.0.0",
  "type": "module",
  "description": "Isomorphic logging plus OpenTelemetry tracer/meter aliases.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primandproper/platform-ts.git",
    "directory": "packages/observability"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      }
    }
  },
  "types": "./dist/index.node.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@primandproper/errors": "workspace:*",
    "pino": "9.14.0",
    "zod": "3.25.76"
  }
}
